<div style="max-height:500px; max-width:600px; word-break:break-all; overflow-y:auto;">
{{#each-in model as |key value|}}
  <div class="container-statues text-left">
    <div class="container-statues__key">
      {{key}}
    </div>
    <div class="container-statues__value">
      {{value}}
    </div>
  </div>
{{/each-in}}
</div>
