<section class="header">
  <h1 class="pull-left">
    {{t (concat "f5CISPage.title")}}
  </h1>
</section>

{{#banner-message color="bg-info"}}
  <p>
    {{#if enabled}}
      {{t "f5CISPage.toUpdate"}}
    {{else}}
      {{t "f5CISPage.disabled"}}
    {{/if}}
  </p>
{{/banner-message}}

{{#if loading}}
  <section class="row">
    <div class="text-center">
      <i class="icon icon-spinner icon-spin icon-3x"></i>
    </div>
  </section>
{{else}}
  <div class="box mb-10">
    <div class="row">
      <div class="col span-6">
        <label class="acc-label">
          {{t "f5CISPage.form.version"}}
          {{#if (and enabled latestVersion templateVersion (not-eq latestVersion templateVersion))}}
            <span class="bg-warning pt-0 pb-0 pl-5 pr-5">
              {{t "monitoringPage.upgradeAvailable" version=latestVersion}}
            </span>
          {{/if}}
        </label>
        {{new-select
          classNames="form-control"
          content=versionChoices
          value=templateVersion
        }}
      </div>
    </div>

    <hr class="mt-15 mb-15"/>

    <section class="clearfix">
      <div class="right-buttons pull-right">
        {{#if pasteOrUpload}}
          <button
            {{action "cancel"}}
            type="button"
            class="btn btn-sm bg-primary"
          >
            {{t "clusterNew.advanced.cancel"}}
          </button>
        {{else}}
          <button
            class="btn btn-sm bg-primary"
            {{action "showPaste"}}
          >
            {{t "clusterNew.advanced.yaml"}}
            <span class="icon icon-copy" />
          </button>
        {{/if}}
      </div>
    </section>

    {{#if pasteOrUpload}}
        <div class="p-20">
        {{input-yaml
          showUpload=false
          showDownload=false
          canChangeName=false
          value=pastedAnswers
          autoResize=true
        }}
      </div>
      {{top-errors errors=yamlErrors}}
    {{else}}
      <div class="row">
        <div class="col span-6">
          <label class="acc-label">
            {{t "f5CISPage.form.url.label"}}
            {{field-required}}
          </label>
          {{schema/input-string
            value=url
            placeholder=(t "f5CISPage.form.url.placeholder")
          }}
        </div>
        <div class="col span-6">
          <label class="acc-label">
            {{t "f5CISPage.form.partition.label"}}
            {{field-required}}
          </label>
          {{schema/input-string
            value=partition
            placeholder=(t "f5CISPage.form.partition.placeholder")
          }}
        </div>
      </div>

      <div class="row">
        <div class="col span-6">
          <label class="acc-label">
            {{t "f5CISPage.form.username.label"}}
            {{field-required}}
          </label>
          {{schema/input-string
            value=username
            placeholder=(t "f5CISPage.form.username.placeholder")
          }}
        </div>
        <div class="col span-6">
          <label class="acc-label">
            {{t "f5CISPage.form.password.label"}}
            {{field-required}}
          </label>
          {{input
            type="password"
            value=password
            placeholder=(t "f5CISPage.form.password.placeholder")
          }}
        </div>
      </div>

      <hr class="mt-15 mb-15"/>

      <div class="row">
        <div class="col span-6">
          <label class="acc-label">
            {{t "f5CISPage.form.type"}}
          </label>
          {{new-select
            value=networkType
            content=networkTypeChoises
          }}
        </div>
      </div>

      <div class="row">
        {{#if networkTypeIsFlannel}}
          <div class="col span-6">
            <label class="acc-label">
              {{t "f5CISPage.form.pool"}}
            </label>
            {{new-select
              value=poolMemberType
              content=poolMemberTypeChoises
            }}
          </div>
        {{/if}}

        {{#if (and networkTypeIsFlannel (eq poolMemberType "cluster"))}}
          <div class="col span-6">
            <label class="acc-label">
              {{t "f5CISPage.form.flannelName.label"}}
            </label>
            {{schema/input-string
              value=flannelName
              placeholder=(t "f5CISPage.form.flannelName.placeholder")
            }}
          </div>
        {{/if}}
      </div>

      <hr class="mt-15 mb-15"/>

      <div class="row">
        <div class="col span-8 row">
          <label class="acc-label">{{t "f5CISPage.form.ipam.label"}}</label>
          <div class="radio">
            <label>
              {{radio-button selection=ipam.enable value=false}}
              {{t 'generic.disabled'}}
            </label>
          </div>
          <div class="radio">
            <label>
              {{radio-button selection=ipam.enable value=true}}
              {{t 'generic.enabled'}}
            </label>
          </div>
        </div>
      </div>

      {{#if ipam.enable}}
      <div class="row">
        <div class="row">
          <div class="col span-6">
            <label class="acc-label">{{t "f5CISPage.form.ipam.pvc.label"}}</label>
            {{input
              class="form-control"
              value=ipam.volume.pvc
              placeholder=(t "f5CISPage.form.ipam.pvc.placeholder")
            }}
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col span-8">
          <label class="acc-label">{{t "f5CISPage.form.ipam.ipRange.label"}}</label>
          {{#if ipRanges.length}}
          <table class="table fixed no-lines small mb-10">
            <thead>
              <tr class="hidden-sm">
                <th class="acc-label">{{t "f5CISPage.form.ipam.ipRange.key.label"}}{{field-required}}</th>
                <th class="acc-label">{{t "f5CISPage.form.ipam.ipRange.start.label"}}{{field-required}}</th>
                <th width="10"/>
                <th class="acc-label">{{t "f5CISPage.form.ipam.ipRange.end.label"}}{{field-required}}</th>
                <th width="40">&nbsp;</th>
              </tr>
            </thead>
            <tbody>
              {{#each ipRanges as |range|}}
                <tr>
                  <td >
                    {{input  placeholder=(t "f5CISPage.form.ipam.ipRange.key.placeholder") value=range.key}}
                  </td>
                  <td >
                    {{input  placeholder=(t "f5CISPage.form.ipam.ipRange.start.placeholder") value=range.rangeStart}}
                  </td>
                  <td>-</td>
                  <td>
                    {{input  placeholder=(t "f5CISPage.form.ipam.ipRange.end.placeholder") value=range.rangeEnd}}
                  </td>
                  <td>
                    <button class="{{if (eq ipRanges.length 1) "disabled "}}btn bg-primary btn-sm" {{action "removeIPRange" range}}>
                      <i class="icon icon-minus"/><span class="sr-only">{{t 'generic.remove'}}</span>
                    </button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
          {{/if}}
          <div>
            <button class="btn btn-sm bg-primary" {{action "addIPRange"}}>
            <i class="icon icon-plus text-small"/>
            <span>{{t "f5CISPage.form.ipam.ipRange.add"}}</span>
          </button>
          </div>
        </div>
      </div>
      {{/if}}

      {{#advanced-section advanced=advanced}}
        {{form-key-value
          initialMap=customAnswers
          changed=(action (mut customAnswers))
          allowEmptyValue=true
          addInitialEmptyRow=false
          editing=true
          header=(t "newCatalog.answers.label")
          addActionLabel="newCatalog.answers.addAction"
          keyLabel="newContainer.environment.keyLabel"
          keyPlaceholder="newContainer.environment.keyPlaceholder"
          valueLabel="newContainer.environment.valueLabel"
          valuePlaceholder="newContainer.environment.valuePlaceholder"
        }}
      {{/advanced-section}}
    {{/if}}
  </div>
{{/if}}

{{#if (eq poolMemberType "cluster")}}
  {{banner-message
    icon="icon-alert"
    color="bg-warning mb-10"
    message=(t "f5CISPage.warning" htmlSafe=true)
  }}
{{/if}}

{{top-errors errors=errors}}

<div class="text-center">
  {{#save-cancel
    saveDisabled=saveDisabled
    cancelDisabled=true
    editing=enabled
    createLabel="f5CISPage.enableActionLabel"
    save=(action "enable")
  }}
    {{#if (and enabled)}}
      {{#if confirmDisable}}
        <button class="btn bg-error" {{action "disable"}}>
          <i class="icon icon-alert"></i> {{t "f5CISPage.confirmDisable"}}
        </button>
      {{else}}
        <button class="btn bg-error" {{action "promptDisable"}}>
            {{t "f5CISPage.disable"}}
          </button>
      {{/if}}
    {{/if}}
  {{/save-cancel}}
</div>
