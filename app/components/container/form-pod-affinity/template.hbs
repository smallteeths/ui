{{#accordion-list-item
  title=(t "podScheduling.title")
  detail=(t "podScheduling.detail" appName=settings.appName)
  expandAll=expandAll
  expand=(action expandFn)
}}
<div class="row">
  <label class="acc-label">{{t 'podScheduling.label'}}</label>
</div>
{{#each rules as |rule|}}
  <div class="row">
    <div class="col span-12 box">
      {{pod-selector
        editing=editing
        remove=(action "remove" rule)
        affinityType=rule.affinityType
        affinityPriority=rule.affinityPriority
        rules=rule.expressions
        currentNamespace=rule.currentNamespace
        selectedNamespaces=rule.selectedNamespaces
        topologyKey=rule.topology
      }}
    </div>
  </div>
{{/each}}
{{#if editing}}
  <button class="btn bg-link icon-btn" type="button" {{action "addPodScheduling"}}>
    <i class="icon icon-plus text-small"/>
    <span>{{t 'podScheduling.add'}}</span>
  </button>
{{/if}}
{{/accordion-list-item}}
