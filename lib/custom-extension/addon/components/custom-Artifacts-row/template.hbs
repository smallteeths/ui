<td valign="middle" class="row-check" style="padding-top: 2px;">
  {{check-box nodeId=model.id}}
</td>

<td data-title="{{dt.artifacts}}">
  <TooltipElement
    @type="tooltip-basic"
    @tooltipTemplate="tooltip-harbor-digest"
    @placement="top"
    @model={{model.digest}}
    @classNames="full-width"
    @style="100%;"
  >
    <span>{{digest}}</span>
  </TooltipElement>
</td>
<td data-title="{{dt.pullCommand}}">
  {{copy-to-clipboard clipboardText=pullCommand size="small"}}
</td>
<td data-title="{{dt.tags}}">
  <TooltipElement
    @type="tooltip-basic"
    @tooltipTemplate="tooltip-harbor-tags"
    @placement="top"
    @model={{tagsTooltipModel}}
    @classNames="full-width"
    @style="100%;"
  >
    <span>{{tags}}</span>
  </TooltipElement>
</td>
<td data-title="{{dt.size}}">
  {{size}}
</td>
<td data-title="{{dt.labels}}">
  {{#if labels}}
    {{#each labels as |label|}}
    <div style={{label.cssStyle}}>
      <img src="{{app.baseAssets}}assets/images/harbor-label.svg" width="10" height="10" style={{label.iconCssStyle}} /><span>{{label.name}}</span>
    </div>
    {{/each}}
  {{/if}}
</td>
<td data-title="{{dt.annotations}}">
  {{model.annotations}}
</td>
<td data-title="{{dt.pullTime}}">
  {{#if hasPullTime}}
    {{date-from-now model.pull_time}}
  {{/if}}
</td>
<td data-title="{{dt.pushTime}}">
  {{#if hasPushTime}}
    {{date-from-now model.push_time}}
  {{/if}}
</td>
<td data-title="{{dt.actions}}" class="actions">
  {{custom-action-menu model=model resourceActions=resourceActions menuClick=(action 'handleMenuClick')}}
</td>
