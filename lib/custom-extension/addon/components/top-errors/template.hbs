<div class="banner-icon">
  <i class="icon icon-alert"></i>
</div>
<div class="banner-message">
    {{#each errors as |error|}}
      {{#if (is-array error)}}
        {{#each error as |line|}}
          <p style="word-break: break-all;">{{line}}</p>
        {{/each}}
      {{else}}
        <p style="word-break: break-all;">{{error}}</p>
      {{/if}}
    {{/each}}
</div>
