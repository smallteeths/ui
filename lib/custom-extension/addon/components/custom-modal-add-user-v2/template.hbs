{{#if modalVisible}}
<form class="modal-container alert" style="max-width: 450px;">

  <h2 class="alert-header">{{t "harborConfig.form.addMember.title"}}</h2>
  <hr/>
  <div class="row">
    <div class="col span-12" >
      <label style="margin: 0px 0px 12px;" for="user">{{t "harborConfig.form.addMember.username.label"}}{{field-required}}</label>
      <div>
        {{input id="user" class="form-control" value=username placeholder=(t "harborConfig.form.addMember.username.placeholder")}}
      </div>
    </div>
    <div class="col span-12" >
      {{top-errors errors=errors}}
    </div>
    <div class="col span-12" style="margin-bottom: 40px">
      <label style="margin: 12px 0px;">{{t "harborConfig.form.addMember.role.label"}}{{field-required}}</label>
      {{new-select
        value=role
        optionLabelPath="name"
        optionValuePath="id"
        content=checkRadio
      }}
    </div>
  </div>
{{save-cancel saving=saving save=(action "save") cancel=(action "cancel")}}
</form>
{{/if}}
