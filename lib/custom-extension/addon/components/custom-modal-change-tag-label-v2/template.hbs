{{#if modalVisible}}
<form class="modal-container large-modal alert">
  {{top-errors errors=errors}}
  <h2 class="alert-header">{{t "imageRepoSection.tagPage.addLabel"}}</h2>
  <hr/>
  <div style="display: flex;flex-wrap:wrap;">
    {{#each labels as |item|}}
      <label style={{item.style}} class="clip harbor-label-cn">
        {{input type="checkbox" class="form-control" checked=item.checked}}
        <div></div> 
        <img src="{{app.baseAssets}}assets/images/harbor-label.svg" width="10" height="10"/>
        <span>{{item.name}}</span>
      </label>
    {{/each}}
  </div>
{{save-cancel editing=editing save=(action "save") cancel=(action "cancel") createLabel="imageRepoSection.adminConfigPage.saveHarborConfig"}}
</form>
{{/if}}
