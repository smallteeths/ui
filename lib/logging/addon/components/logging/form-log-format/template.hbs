<div class="row mt-30">
  <h2 class="mt-0">
    {{t "loggingPage.additional.header"}}
  </h2>

  <hr/>

  <div class="col span-5">
    <section class="additional-logging-configuration-content">
      <label>{{t "loggingPage.additional.fields.header"}}</label>
      <div class="mb-30">
        <p class="text-info text-small">{{t "loggingPage.additional.fields.helpText"}}</p>
        <FormKeyValue
          @addActionLabel="loggingPage.tags.addActionLabel"
          @initialMap={{model.outputTags}}
          @changed={{action (mut model.outputTags)}}
        />
      </div>

      {{#if (not-eq targetType "customTarget")}}
        <div class="row mb-30">
          <div class="col">
            <label class="acc-label" for="output-flush-interval">
              {{t "loggingPage.additional.flushInterval.label"}}
            </label>
            <div class="input-group">
              <InputInteger
                @min=1
                @value={{model.outputFlushInterval}}
                @class="form-control"
                id="output-flush-interval"
                @placeholder={{t "loggingPage.additional.flushInterval.placeholder"}}
                aria-describedby="basic-addon2"
              />
              <span class="input-group-addon bg-default" id="basic-addon2">
                {{t "loggingPage.additional.flushInterval.sec"}}
              </span>
            </div>
            <p class="text-info text-small mb-0">{{t "loggingPage.additional.flushInterval.helpText"}}</p>
          </div>
        </div>
      {{/if}}

      {{#if (eq pageScope "cluster")}}
        <label 
          class="row flex-align-center" 
          for="include-system-component"
        >
          <Input
            @type="checkbox"
            class="form-control mr-5"
            id="include-system-component"
            @checked={{model.includeSystemComponent}}
          />
          {{t "loggingPage.additional.includeSystemComponent.label"}}
        </label>
      {{/if}}

      <label 
        class="row flex-align-center"
        for="enable-json-parsing"
      >
        <Input
          @type="checkbox"
          class="form-control mr-5"
          id="enable-json-parsing"
          @checked={{loggingModel.enableJSONParsing}}
        />
        {{t "loggingPage.additional.jsonParsing.label"}}
      </label>

      {{#if (and (not-eq targetType "syslog") (not-eq customType "syslog"))}}
        <label 
          class="row flex-align-center"
          for="enable-multi-line-merge"
        >
          {{input
            type="checkbox"
            classNames="form-control mr-5"
            checked=model.enableMultiLineMerge
            id="enable-multi-line-merge"
          }}
          {{t "loggingPage.additional.enableMultiLineMerge.label"}}
        </label>

        {{#if model.enableMultiLineMerge}}
          <div class="ml-10">
            <label 
              class="row flex-align-center"
              for="enable-exception-stack-match"
            >
              {{input
                type="checkbox"
                classNames="form-control mr-5"
                checked=model.enableExceptionStackMatch
                id="enable-exception-stack-match"
              }}
              {{t "loggingPage.additional.enableExceptionStackMatch.label"}}
            </label>
            <p class="text-info text-small mt-0 mb-0 ml-25">
              {{t "loggingPage.additional.enableExceptionStackMatch.description"}}
            </p>
            <label 
              class="row flex-align-center"
              for="enable-multi-line-filter"
            >
              {{input
                type="checkbox"
                classNames="form-control mr-5"
                checked=model.enableMultiLineFilter
                id="enable-multi-line-filter"
              }}
              {{t "loggingPage.additional.enableMultiLineFilter.label"}}
            </label>

            {{#if model.enableMultiLineFilter}}
              <div classNames="row">
                <div classNames="col">
                  <label class="acc-label">
                    {{t "loggingPage.additional.multiLineStartRegexp.label"}}
                    </label>
                    {{input
                      value=model.multiLineStartRegexp
                      class="form-control"
                    }}
                </div>
              </div>
              <div classNames="row">
                <div classNames="col">
                  <label class="acc-label">
                    {{t "loggingPage.additional.multiLineEndRegexp.label"}}
                    </label>
                    {{input
                      value=model.multiLineEndRegexp
                      class="form-control"
                    }}
                </div>
              </div>
            {{/if}}
          </div>
        {{/if}}
      {{/if}}
    </section>
  </div>

  <div class="col span-7 logging-format">
    <Logging::CodeBlock
      @code={{logPreview}}
      @language="json"
    />
  </div>
</div>