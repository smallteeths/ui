{{#accordion-list-item
    title=(t "clusterConnectMode.title")
    detail=(t "clusterConnectMode.detail")
    expandAll=expandAll
    expand=(action expandFn)
    expanded=expanded
    as | parent |
}}
  
{{#if connectMode}}
  <div class="row">
    <div class="col span-12">
        {{t "clusterConnectMode.connectMode.label"}}:
      {{#if (eq connectMode.directAccess 'true')}}
        Tunnel & Direct
      {{else}}
        Tunnel
      {{/if}}
    </div>
  </div>
  <div class="box">
    <div class="row">
      <div class="col span-5">
        <label class="p-0 acc-label vertical-middle">{{t "clusterConnectMode.connectStatus.timeout"}}:</label>
        {{timeout}} {{t "generic.seconds"}}
      </div>
      <div class="col span-6">
        <label class="p-0 acc-label vertical-middle">{{t "clusterConnectMode.connectStatus.apiEndpoint"}}:</label>
        {{cluster.apiEndpoint}}
      </div>
      <div class="col span-10">
        {{form-value-array-with-status
          initialValues=connectMode.apiEndpoints
          valueLabel="clusterConnectMode.apiEndpoint.overrideLabel"
          status=statusMap
          editing=false
        }}
      </div>
    </div>
  </div>
{{/if}}
{{top-errors errors=errors}}
{{/accordion-list-item}}
