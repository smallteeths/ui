{{#accordion-list-item
    title=(t "clusterConnectMode.title")
    detail=(t "clusterConnectMode.detail")
    expandAll=expandAll
    expand=(action expandFn)
    expanded=expanded
    as | parent |
}}
  
{{#if connectMode}}
  <div class="row">
    <div class="col span-12">
        {{t "clusterConnectMode.connectMode.label"}}:
      {{#if (eq connectMode.directAccess 'true')}}
        Tunnel & Direct
      {{else}}
        Tunnel
      {{/if}}
      <button class="btn bg-transparent" type="button" {{action "showEditModal"}}>
        <i class="icon icon-edit"></i>
        {{t "generic.edit"}}
      </button>
    </div>
  </div>
{{/if}}

  {{#if connectStatus}}
  <div class="row box">
     <div class="col span-4">
      <label class="acc-label vertical-middle p-0">{{t "clusterConnectMode.connectStatus.timeout"}}:</label>
      {{timeout}} {{t "generic.seconds"}}
    </div>
    <div class="col span-4">
      <label class="acc-label vertical-middle p-0">{{t "clusterConnectMode.connectStatus.apiEndpoint"}}:</label>
      {{connectStatus.ClusterManagerState.ClusterStatus.APIEndpoint}}
    </div>
  </div>
  {{/if}}

{{top-errors errors=connectStatusErrors}}
{{top-errors errors=connectModeErrors}}
{{/accordion-list-item}}
