<section class="header">
  <h1>{{t "clusterConnectMode.title"}}</h1>
</section>

<div class="row">
  <div class="col box span-6">
    <label class="acc-label">
      {{t "clusterConnectMode.connectMode.label"}}
    </label>
    {{new-select
      content=connectModes
      value=model.directAccess
    }}
  </div>
   <div class="col box span-6">
    {{form-value-array-with-status
      initialValues=initValues
      valueLabel="clusterConnectMode.apiEndpoint.label"
      valuePlaceholder="clusterConnectMode.apiEndpoint.placeholder"
      addActionLabel="generic.add"
      status=statusMap
      changed=(action (mut model.apiEndpoints))
    }}
  </div>
</div>
<div class="mt-40 over-hr">
  <button class="bg-info btn" type="button" {{action "testConnectMode"}} disabled={{loading}}>
    {{t "clusterConnectMode.testConnect.label"}}
  </button>

</div>
{{#if testSuccess}}
  {{#banner-message color="bg-success"}}
    <p>{{t "clusterConnectMode.testConnect.success"}}</p>
  {{/banner-message}}
{{/if}}
{{top-errors errors=errors}}
<div class="center">
  <button class="bg-primary btn" type="button" {{action "doSaveAndRestart"}} disabled={{loading}}>
  {{t "generic.save"}}
  </button>
  &nbsp;
  <button class="bg-transparent btn" type="button" {{action "cancel"}} disabled={{loading}}>
  {{t "generic.cancel"}}
  </button>
</div>
