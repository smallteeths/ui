<div class="container-header-text text-center">
  <h3>
    {{t 'clusterNew.rke.network.macVlanStatus.upgradeModal.title'}}
  </h3>
  <hr>
</div>
<div class="row">
  <div class="col span-12">
    {{t 'clusterNew.rke.network.macVlanStatus.upgradeModal.message' clusterName=clusterName networkPlugin=networkPlugin}}
    {{#banner-message color="bg-info"}}
    <p>
      {{t 'clusterNew.rke.network.macVlanStatus.upgradeModal.warning'}}
    </p>
    {{/banner-message}}
  </div>
</div>
<div class="footer-actions">
  {{save-cancel
    cancel=(action "cancel")
    createLabel="clusterNew.rke.network.macVlanStatus.upgradeModal.upgrade"
    save=(action "confirm")
  }}
</div>
