<section class="header has-tabs clearfix p-0">
  <ul class="tab-nav">
    {{#if (rbac-allows resource="virtualserver" scope="project" permission="list")}}
      <li>{{#link-to-external "authenticated.project.f5.controllers.index" scope.currentProject.id}}{{t "nav.f5.controllers"}}{{/link-to-external}}</li>
    {{/if}}
    {{#if (rbac-allows resource="tlsprofile" scope="project" permission="list")}}
      <li>{{#link-to-external "authenticated.project.f5.tls.index" scope.currentProject.id}}{{t "nav.f5.tls"}}{{/link-to-external}}</li>
    {{/if}}
  </ul>

  <div class="right-buttons">
    {{yield}}
  </div>
</section>
