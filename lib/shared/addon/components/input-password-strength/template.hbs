<div class="row">
  <div class="col span-12">
    <label class="acc-label password-meter-label">
      {{t "modalEditPassword.strength.label"}} <span class="{{passwordStrengthValue}}">{{passwordStrengthText}}</span>
    </label>
    <div class="password-meter-content">
      <div class="{{passwordStrengthClass}}">
        <div class="weak"></div>
        <div class="good"></div>
        <div class="best"></div>
      </div>
    </div>
  </div>
</div>