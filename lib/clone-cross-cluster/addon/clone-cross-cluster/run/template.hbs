
<section class="header clearfix">
  <h1>
    {{t 'cloneCrossCluster.newContainer.title'}}
  </h1>
</section>
{{#if supportClone}}
{{new-workload
  service=model.workloadForNew.workload
  serviceUUID=model.workloadForNew.uuid
  projects=model.projects
  clusters=model.clusters
  namespaceSecrets=model.namespaceSecrets
  projectSecrets=model.projectSecrets
  namespaceConfigMaps=model.namespaceConfigMaps
  namespacedCertificates=model.namespacedCertificates
  persistentVolumeClaims=model.persistentVolumeClaims
  certificates=model.certificates
  namespacedDockerCredentials=model.namespacedDockerCredentials
  projectDockerCredentials=model.projectDockerCredentials
  loggingEnabled=model.loggingEnabled
  allServices=model.allServices
  serviceId=model.serviceId
}}
{{else}}
  {{#banner-message color='bg-error m-0'}}
    {{t 'cloneCrossCluster.newContainer.errors.appCloneNotSupport'}}
  {{/banner-message}}
{{/if}}
