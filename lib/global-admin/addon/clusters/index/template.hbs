<section class="header {{if showMetricsTab "has-tabs"}}">
  {{#if showMetricsTab}}
    <ul class="tab-nav">
      <li>
        {{#link-to
          "clusters.index.list"
        }}
          {{t "clustersPage.header"}}
        {{/link-to}}
      </li>
      <li>
        {{#link-to
          "clusters.index.metrics"
        }}
          {{t "clustersPage.metricsHeader"}}
        {{/link-to}}
      </li>
    </ul>
  {{else}}
    <h1 class="pull-left">
      {{t "clustersPage.header"}}
    </h1>
  {{/if}}

  <div class="right-buttons">
    {{#if showMetricsTab}}
      <div class="inline-block vertical-bottom mr-20">
        <a
          class="inline-block"
          href={{globalMonitoringUrl}}
          target="_blank"
          rel="nofollow noopener noreferrer"
        >
          {{#tooltip-element
              classNames="max-full-width global-monitoring block"
              type="tooltip-basic"
              tooltipTemplate='-tooltip-break-all'
              model=(t "globalMonitoringPage.links.globalMonitoring.label")
              placement="top"
          }}
          {{/tooltip-element}}
        </a>

        <a
          class="inline-block"
          href={{grafanaUrl}}
          target="_blank"
          rel="nofollow noopener noreferrer"
        >
          {{#tooltip-element
              classNames="max-full-width grafana block"
              type="tooltip-basic"
              tooltipTemplate='-tooltip-break-all'
              model=(t "globalMonitoringPage.links.grafana.label")
              placement="top"
          }}
          {{/tooltip-element}}
        </a>

        <a
          class="inline-block"
          href={{thanosUrl}}
          target="_blank"
          rel="nofollow noopener noreferrer"
        >
          {{#tooltip-element
              classNames="max-full-width thanos block"
              type="tooltip-basic"
              tooltipTemplate='-tooltip-break-all'
              model=(t "globalMonitoringPage.links.thanos.label")
              placement="top"
          }}
          {{/tooltip-element}}
        </a>
      </div>
    {{/if}}

    {{#link-to
       "clusters.new"
       class="btn btn-sm bg-primary"
       disabled=(rbac-prevents resource="cluster" scope="global" permission="create")
    }}
      {{t "clustersPage.newCluster"}}
    {{/link-to}}
  </div>
</section>

{{outlet}}
