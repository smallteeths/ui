{{#if scope.currentCluster.isReady}}
  {{#banner-message color="bg-warning"}}
    <p>{{t 'banner.alerting' dashboardLink=scope.dashboardLink docsBase=scope.docsBase htmlSafe=true}}</p>
  {{/banner-message}}
{{/if}}

<section class="header clearfix">
  <div class="pull-left pt-10"><h1 class="text-capitalize">{{if (eq pageScope 'cluster') (t 'alertPage.cluster') (t 'alertPage.project')}} {{t 'alertPage.alertGroups'}}</h1></div>
  <div class="right-buttons">
    {{#link-to "new" classNames="btn btn-sm bg-primary"}}{{t 'alertPage.index.addAlertGroup'}}{{/link-to}}
  </div>
  {{#if (eq pageScope "cluster")}}
    <div class="right-buttons">
      {{#link-to "config" classNames="btn btn-sm bg-primary mr-10"}}
        {{t 'alertPage.index.config'}}
      {{/link-to}}
    </div>
  {{/if}}
</section>

{{alert-table alerts=model.alerts notifiers=model.notifiers groups=model.groups}}
